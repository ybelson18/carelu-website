{
  "$comment": [
    "RESEARCH WORKLIST for the payer directory \u2014 WHO to cover and WHAT to ask, never the answers.",
    "Answers come only from primary sources fetched during the monthly refresh, cited inline, per the",
    "VERIFIED-ONLY rule in docs/monthly-refresh.md. Nothing here is copied from any third party's material.",
    "Origin: a coverage gap analysis run 2026-09-17 against src/data/payers/*.ts. Commercial coverage at",
    "that point was four carrier families (Aetna, Cigna, UnitedHealthcare, Anthem GA) across 19 states;",
    "these are the payers that actually appear on ABA leads in those same states and had no guide."
  ],
  "created": "2026-09-17",
  "ruleFields": [
    {
      "id": "supervision",
      "label": "Supervision",
      "question": "What supervision does this payer require over technicians delivering 97153 \u2014 a percentage floor, a ratio cap, direct vs. asynchronous, and who may supervise?",
      "sourceHint": "State Medicaid provider/billing manual; payer ABA clinical policy; provider agreement."
    },
    {
      "id": "concurrentBilling",
      "label": "Concurrent billing (97153 + 97155)",
      "question": "May 97153 and 97155 be billed for the same clock time for the same member, and under what conditions (direction-of-technician vs. direct treatment)?",
      "sourceHint": "Payer ABA reimbursement policy; state manual concurrent-services section; NCCI/CMS edits."
    },
    {
      "id": "dailyLimits",
      "label": "Daily limits / MUEs",
      "question": "What per-day unit ceilings does this payer enforce per ABA code, and does it follow Medicaid or Medicare MUE tables or publish its own limits?",
      "sourceHint": "CMS MUE tables (Medicaid vs. Practitioner); payer reimbursement policy; state fee schedule."
    },
    {
      "id": "noteSignature",
      "label": "Session-note signature",
      "question": "Who must sign each session note (rendering technician, supervising BCBA, both), and within what timeframe?",
      "sourceHint": "State manual documentation standards; payer audit/documentation policy."
    },
    {
      "id": "placeOfService",
      "label": "Place of service",
      "question": "Is ABA payable in school, in the community, and in a group home \u2014 and with which POS codes or restrictions?",
      "sourceHint": "State manual place-of-service section; payer policy; POS code table."
    },
    {
      "id": "billAsProvider",
      "label": "Bill as provider",
      "question": "Whose NPI must the claim carry \u2014 rendering technician, supervising analyst, or the group/agency \u2014 and what modifiers ride along?",
      "sourceHint": "State manual billing section; payer claims/billing guide; enrollment rules."
    }
  ],
