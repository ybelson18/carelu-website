{
  "rewrites": [
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?leadtrap\\.com"
        }
      ],
      "destination": "/static/leadtrap-privacy.html"
    },
    {
      "source": "/terms",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?leadtrap\\.com"
        }
      ],
      "destination": "/static/leadtrap-terms.html"
    },
    {
      "source": "/privacy",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?carelu\\.com"
        }
      ],
      "destination": "/static/carelu-privacy.html"
    },
    {
      "source": "/terms",
      "has": [
        {
          "type": "host",
          "value": "(www\\.)?carelu\\.com"
        }
      ],
      "destination": "/static/carelu-terms.html"
    },
    {
      "source": "/privacy/:company",
      "destination": "/api/policy?kind=privacy&company=:company"
    },
    {
      "source": "/terms/:company",
      "destination": "/api/policy?kind=terms&company=:company"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|gif|svg|ico|mp4|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
